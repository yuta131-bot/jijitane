            {
              "q": "1 km は、何 m？",
              "a": "1000 m"
            },
            {
              "q": "1 L は、何 cm³？",
              "a": "1000 cm³"
            },
            {
              "q": "1 ha は、何 m²？",
              "a": "10000 m²"
            },
            {
              "q": "3/8 を小数で表すと？",
              "a": "0.375"
            },
            {
              "q": "0.4 は、何％？",
              "a": "40％"
            },
            {
              "q": "時速72kmは、秒速何m？",
              "a": "20 m"
            },
            {
              "q": "500円の3割引は、いくら？",
              "a": "500×0.7＝350円"
            },
            {
              "q": "時速60kmで2時間30分走ると、何km進む？",
              "a": "60×2.5＝150 km"
            },
            {
              "q": "2割ふえると、もとの何倍？",
              "a": "1.2倍"
            },
            {
              "q": "食塩50gと水150gでできる食塩水の濃さは？",
              "a": "50÷(50＋150)×100＝25％"
            }
          ]
        },
        {
          "t": "memo",
          "title": "まちがえた問題をメモしよう（どこでまちがえた？）",
