            "t": "cards",
            "title": "割合の3つの式",
            "cols": 1,
            "items": [
              {
                "h": "もとにする量・くらべる量・割合",
                "c": "o",
                "lines": [
                  "割合 ＝ くらべる量 ÷ もとにする量",
                  "くらべる量 ＝ もとにする量 × 割合",
                  "もとにする量 ＝ くらべる量 ÷ 割合",
                  "「〜の」「〜に対して」の前が、もとにする量"
                ]
              },
              {
                "h": "ふえた・へった",
                "c": "b",
                "lines": [
                  "2割ふえた → もとの × 1.2",
                  "2割へった → もとの × 0.8",
                  "定価の2割引 → 定価 × 0.8",
                  "利益 ＝ 売った値段 − 原価（原価に利益を足して定価）"
                ]
              }
            ]
